{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/beta/index",
      "destination": "/beta/",
      "permanent": true
    },
    {
      "source": "/beta/v2",
      "destination": "/beta/",
      "permanent": false
    },
    {
      "source": "/beta/v5",
      "destination": "/beta/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/beta",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/beta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
